{
 "feature_name": "清理/销毁跨函数直接释放后读取对象字段",
 "precondition": [
  "堆对象由创建、解析或分配路径产生，并由清理、销毁、引用计数或生命周期路径负责释放。",
  "释放发生在某个清理/销毁/生命周期阶段，旧指针随后通过参数或共享结构被传入另一清理/生命周期阶段。",
  "后续阶段在未把旧指针重新指向新对象的情况下读取其字段。",
  "被读取的字段通常是引用计数、类型标记、容器边界、数据缓冲指针或解析树/命名空间属性。",
  "触发输入使清理或生命周期路径重复进入，或在对象已释放后仍被后续阶段访问。"
 ],
 "trigger_path": [
  "输入构造出带有清理回调、引用计数或生命周期状态的对象/容器/解析结果。",
  "某清理或销毁路径释放该对象，但旧指针仍保留在参数、共享结构或延迟处理队列中。",
  "后续清理或生命周期路径以同一旧指针继续处理，且期间没有把该指针重新指向有效对象。",
  "后续路径读取已释放对象的字段，触发跨函数释放后使用。"
 ],
 "mutation_target": [
  "对象生命周期计数与状态字段（引用计数增减 / 类型枚举值 / 销毁状态标志）",
  "容器或列表的边界与元素指针字段（元素个数 / 起始与结束指针 / 槽位数组）",
  "对象内嵌数据缓冲的指针与长度字段（数据指针 / 数据长度 / 块长度）",
  "解析树与命名空间属性字段（前缀指针 / 命名空间指针 / 属性码 / 字符串值）"
 ],
