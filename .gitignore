reproduce_crash/**/*.zip

# ── Python / 临时 ──
__pycache__/
*.pyc
.pytest_cache/
behav_*/
tmp*/

# ── 可能含密钥的本地配置 ──
.env
*.key
*.pem
!requirements.txt

# ── 复现 artifacts：日志/样本/二进制（401 MB，属于数据集，不进代码仓）──
reproduce_crash/artifacts/
*.bak_archived
*.log.gz

